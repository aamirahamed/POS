{
    "manifest_version": 3,
    "name": "Save Job to POS",
    "version": "1.0.0",
    "description": "AI-powered job extraction for your Personal Operating System",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "identity"
    ],
    "host_permissions": [
        "http://localhost:5173/*",
        "https://pos-system-three.vercel.app/*"
    ],
    "action": {
        "default_popup": "index.html"
    },
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content/index.ts"
            ]
        },
        {
            "matches": [
                "http://localhost:5173/*",
                "https://pos-system-three.vercel.app/*"
            ],
            "js": [
                "src/content/auth-sync.ts"
            ],
            "run_at": "document_idle"
        }
    ]
}